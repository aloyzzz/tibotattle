{
  "name": "tibotattle",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first usage, cost, allowance and speed monitoring for the oh-my-pi (omp) coding agent.",
  "license": "MIT",
  "bin": {
    "tibotattle": "./bin/tibotattle.js"
  },
  "main": "./apps/electron/main.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node ./bin/tibotattle.js serve",
    "scan": "node ./bin/tibotattle.js scan",
    "report": "node ./bin/tibotattle.js report",
    "doctor": "node ./bin/tibotattle.js doctor",
    "desktop": "electron ./apps/electron/main.js",
    "test": "node --test --test-concurrency=1 test/"
  },
  "devDependencies": {
    "electron": "38.2.2"
  }
}
